diff --git a/src/isa/riscv64/instr/rvv/vcompute_impl.c b/src/isa/riscv64/instr/rvv/vcompute_impl.c
index 4017901a..390198e7 100644
--- a/src/isa/riscv64/instr/rvv/vcompute_impl.c
+++ b/src/isa/riscv64/instr/rvv/vcompute_impl.c
@@ -1848,6 +1848,64 @@ void float_reduction_computing(Decode *s) {
   vstart->val = 0;
 }
 
+/* ------------------------------------------------------------------------
+ * custom-0 vdot.vv: opcode=0x0B, funct6=100000, funct3=000, funct7=funct6<<1|vm
+ *
+ *   vd.e32[i] = sum_{k=0..3} sext8(vs2[4i+k]) * sext8(vs1[4i+k]), i in [0,4)
+ *
+ * vs2/vs1 are always 16 x int8 (vtype.vsew == e8, vlmul == m1) and vl counts
+ * source bytes, so ceil(vl/4) destination elements are produced. The sum is
+ * bounded by [-65024, 65536]; the 32-bit two's complement result is written,
+ * no saturation happens and vxsat is never set.
+ *
+ * mask / tail / vstart are resolved per 32-bit destination element:
+ *   - vstart is a source byte index: element i with i*4 < vstart keeps old vd
+ *   - vm == 0: element i is enabled by v0[i]
+ *   - masked-off element: vma ? 0xffffffff : old vd
+ *   - tail element (i >= ceil(vl/4)): vta ? 0xffffffff : old vd
+ * vstart >= vl leaves vd completely untouched, which is what all the other
+ * NEMU vector instructions do (check_vstart_ignore() in vcommon.c) and what
+ * the XiangShan writeback mux does (outVstartGeVl in VIAluFix.scala).
+ * ------------------------------------------------------------------------ */
+void vector_dot_instr(Decode *s) {
+  require_vector(true); // mstatus.VS != 0 && vtype.vill == 0
+  if (vtype->vsew != 0 || vtype->vlmul != 0 || vl->val > VLEN / 8) {
+    longjmp_exception(EX_II); // only e8 / m1 / vl <= 16 are defined
+  }
+
+  if (vstart->val < vl->val) {
+    const int vlout = ((int)vl->val + 3) / 4; // number of produced e32 elements
+    for (int i = 0; i < VLEN / 32; i++) {     // e32 / m1 => 4 destination elements
+      if ((uint64_t)(i * 4) < vstart->val) {
+        continue; // suppressed by vstart: keep the old vd element
+      }
+      int32_t elem;
+      if (i >= vlout) {
+        if (!vtype->vta) continue; // tail, vta = 0: keep the old vd element
+        elem = -1;
+      } else if (s->vm == 0 && get_mask(0, i) == 0) {
+        if (!vtype->vma) continue; // masked off, vma = 0: keep the old vd element
+        elem = -1;
+      } else {
+        int32_t acc = 0;
+        for (int k = 0; k < 4; k++) {
+          rtlreg_t a = 0, b = 0;
+          get_vreg(id_src2->reg, i * 4 + k, &a, 0, 0, SIGNED, 1); // e8, m1, sext
+          get_vreg(id_src1->reg, i * 4 + k, &b, 0, 0, SIGNED, 1);
+          acc += (int32_t)(a * b);
+        }
+        elem = acc;
+      }
+      rtlreg_t res = (uint32_t)elem;
+      set_vreg(id_dest->reg, i, res, 2, 0, 1); // e32 element i
+    }
+  }
+
+  rtl_li(s, s0, 0);
+  vcsr_write(IDXVSTART, s0);
+  vp_set_dirty();
+}
+
 // dirty job here
 #undef s0
 #undef s1

diff --git a/src/isa/riscv64/instr/rvv/decode.h b/src/isa/riscv64/instr/rvv/decode.h
index ee7618e0..731a032a 100644
--- a/src/isa/riscv64/instr/rvv/decode.h
+++ b/src/isa/riscv64/instr/rvv/decode.h
@@ -46,6 +46,19 @@ static inline def_DHelper(OP_V) { // 10_101, same to R
   */
 }
 
+// custom-0 vdot.vv: opcode=0x0B, funct6=100000, funct3=000, funct7=funct6<<1|vm
+// vd.e32[i] = sum_{k=0..3} sext8(vs2[4i+k]) * sext8(vs1[4i+k]), i in [0, 4)
+// Not a regular .vv op: the sources are always 16 x int8 (e8, m1) and the
+// destination elements are e32, so v_width / vtype are not used for decoding.
+static inline def_DHelper(vdot) {
+  decode_op_r(s, id_src1, s->isa.instr.v_opv.v_vs1, true);
+  decode_op_r(s, id_src2, s->isa.instr.v_opv.v_vs2, true);
+  decode_op_r(s, id_dest, s->isa.instr.v_opv.v_vd, false);
+  s->src_vmode = SRC_VV;
+  s->v_width = 1;
+  s->vm = s->isa.instr.v_opv.v_vm; // 1: unmasked; 0: v0[i] masks 32-bit output element i
+}
+
 static inline def_DHelper(vfunary0_dispatch) {
     s->src_vmode = SRC_V;
 }
